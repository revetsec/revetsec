<!--
	A consumer of the installed RevetSec JAR, as an application sees it. Verification tooling only:
	never published, never built by the root pom. Run it through verify-packaged-consumer.py, which
	copies this project to a scratch directory, builds it against a local repository that holds the
	installed core, and checks the resolved class path, the JAR and its jdeps module list.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.revetsec.verification</groupId>
	<artifactId>packaged-consumer</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>
	<name>RevetSec packaged consumer (verification only)</name>

	<properties>
		<!-- The core version under test. verify-packaged-consumer.py passes the version from the core pom. -->
		<revetsec.version>1.0.0-SNAPSHOT</revetsec.version>
		<maven.compiler.release>17</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.build.outputTimestamp>2026-09-01T00:00:00Z</project.build.outputTimestamp>
		<maven.install.skip>true</maven.install.skip>
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>

	<dependencies>
		<!-- Default (compile) scope, exactly as an application declares it. -->
		<dependency>
			<groupId>com.revetsec</groupId>
			<artifactId>revetsec</artifactId>
			<version>${revetsec.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.5.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.5.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
				<configuration>
					<release>${maven.compiler.release}</release>
					<showWarnings>true</showWarnings>
					<!-- A consumer must compile warning-free without RevetSec's provided-scope annotation JARs. -->
					<failOnWarning>true</failOnWarning>
					<compilerArgs>
						<arg>-Xlint:all</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.11.0</version>
				<executions>
					<execution>
						<!-- Record the class path Maven resolves for this consumer at run time. The script
						requires it to be exactly the RevetSec JAR: no transitive dependency at all. -->
						<id>runtime-classpath</id>
						<phase>compile</phase>
						<goals>
							<goal>build-classpath</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<outputFile>${project.build.directory}/runtime-classpath.txt</outputFile>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
