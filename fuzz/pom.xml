				<targetPath>com/revetsec/internal/pem/PemFuzzTestsInputs/pemParsersRejectOnlyWithPemExceptionAndAcceptAtMostOneLabel/fixtures-keys</targetPath>
				<includes>
					<include>*.pem</include>
				</includes>
			</testResource>
			<testResource>
				<directory>${revetsec.core.basedir}/src/test/resources/com/revetsec/internal/json/corpus</directory>
