			</testResource>
			<testResource>
				<directory>${revetsec.core.basedir}/src/test/resources/vectors/jsontestsuite/test_parsing</directory>
				<targetPath>com/revetsec/internal/jose/JsonWebKeyFuzzTestsInputs/keySetDocumentsSkipExactlyTheKeysAnIndependentOracleRefuses/jsontestsuite</targetPath>
