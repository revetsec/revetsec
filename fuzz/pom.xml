			</testResource>
			<testResource>
				<directory>${revetsec.core.basedir}/src/test/resources/com/revetsec/internal/json/corpus</directory>
				<targetPath>com/revetsec/oauth/ResourceServerFuzzTestsInputs/metadataKeepsRolesAndRawResourceIdentifiers</targetPath>
				<includes><include>parse/**</include><include>round-trip/**</include></includes>
			</testResource>

			<testResource>
				<directory>${revetsec.core.basedir}/src/test/resources/vectors/jsontestsuite/test_parsing</directory>
				<targetPath>com/revetsec/oauth/ResourceServerFuzzTestsInputs/metadataKeepsRolesAndRawResourceIdentifiers/jsontestsuite</targetPath>
				<includes><include>*.json</include></includes>
			</testResource>

			<testResource>
