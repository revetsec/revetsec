				<targetPath>com/revetsec/oauth/ResourceServerFuzzTestsInputs/introspectionResponsesAreTypedAudienceCheckedAndUncached</targetPath>
				<includes><include>parse/**</include><include>round-trip/**</include></includes>
			</testResource>

			<testResource>
				<directory>${revetsec.core.basedir}/src/test/resources/vectors/jsontestsuite/test_parsing</directory>
				<targetPath>com/revetsec/oauth/ResourceServerFuzzTestsInputs/introspectionResponsesAreTypedAudienceCheckedAndUncached/jsontestsuite</targetPath>
				<includes><include>*.json</include></includes>
			</testResource>

		</testResources>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.6.3</version>
				<executions>
					<execution>
						<id>enforce-fuzz-build-contract</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>[3.9.0,)</version>
								</requireMavenVersion>
								<requireJavaVersion>
									<version>[17,)</version>
								</requireJavaVersion>
								<dependencyConvergence/>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<id>add-core-main-sources</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${revetsec.core.basedir}/src/main/java</source>
							</sources>
						</configuration>
					</execution>
					<!-- build-helper's add-test-source has no include/exclude support, so the
						 ITs and scripted-IdP classes are filtered by the compiler's testExcludes
						 below. Test resources do support excludes, but nothing there needs them. -->
					<execution>
						<id>add-core-test-sources</id>
						<phase>generate-test-sources</phase>
						<goals>
							<goal>add-test-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${revetsec.core.basedir}/src/test/java</source>
							</sources>
						</configuration>
					</execution>
					<execution>
						<id>add-core-test-resources</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>add-test-resource</goal>
						</goals>
						<configuration>
							<resources>
								<resource>
									<directory>${revetsec.core.basedir}/src/test/resources</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
				<configuration>
					<release>${maven.compiler.release}</release>
					<compilerArgs>
						<arg>-parameters</arg>
						<arg>-Xlint:unchecked</arg>
					</compilerArgs>
					<proc>none</proc>
					<showDeprecation>true</showDeprecation>
					<showWarnings>true</showWarnings>
					<!-- The excluded files stay on javac's -sourcepath (the compiler plugin passes
						 every source root). If an included file ever references one of them, javac
						 compiles it implicitly and fails on the missing Testcontainers classes, so
						 the leak is loud rather than silent. -->
					<testExcludes>
						<!-- Failsafe/Testcontainers legs never run here. -->
						<testExclude>**/*IT.java</testExclude>
						<!-- ScriptedIdpContainer, ScriptedIdpClient, ScriptedIdpSpecs (plan §14.10)
							 need Testcontainers, which this module does not declare. -->
						<testExclude>com/revetsec/saml/ScriptedIdp*</testExclude>
						<testExclude>com/revetsec/testing/OAuthHttp2Server.java</testExclude>
						<testExclude>com/revetsec/oauth/OAuthHttp2Tests.java</testExclude>
					</testExcludes>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<!-- Fuzz targets run here with FuzzSeedLayoutTests, which checks that every target's
						 seed directory and mapped corpora match its class and method names, FuzzSeedProvenanceTests,
						 which checks generated and Wycheproof-derived seeds against their sources, and
						 FuzzNullabilityContractTests, which attributes all executable fuzz signatures. The core test tree is
						 compiled in for its helpers, but its *Tests classes (contract tests included) run in the
						 root build, whose basedir they assume. Fuzz targets are named *FuzzTests; see README.md. -->
					<includes>
						<include>**/*FuzzTests.java</include>
						<include>com/revetsec/FuzzSeedLayoutTests.java</include>
						<include>com/revetsec/FuzzSeedProvenanceTests.java</include>
						<include>com/revetsec/FuzzNullabilityContractTests.java</include>
					</includes>
					<failIfNoTests>true</failIfNoTests>
					<systemPropertyVariables>
						<!-- FuzzSeedLayoutTests compares the mapped corpora with their sources here. -->
						<revetsec.core.basedir>${revetsec.core.basedir}</revetsec.core.basedir>
					</systemPropertyVariables>
					<argLine>
						-Xmx512m
						-Djdk.attach.allowAttachSelf=true
						-XX:+EnableDynamicAgentLoading
						--enable-native-access=ALL-UNNAMED
						${surefire.unsafeMemoryAccessArg}
					</argLine>
				</configuration>
			</plugin>

			<!-- Tooling only: this module produces no jar and is never installed or deployed. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.5.1</version>
				<executions>
					<execution>
						<id>default-jar</id>
						<phase>none</phase>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<version>3.1.4</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>3.1.4</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>jdk23-plus-unsafe-memory-access</id>
			<activation>
				<jdk>[23,)</jdk>
			</activation>
			<properties>
				<surefire.unsafeMemoryAccessArg>--sun-misc-unsafe-memory-access=allow</surefire.unsafeMemoryAccessArg>
			</properties>
		</profile>

		<!-- Fallback toggle: compile against Revetsec's main sources only, leaving the core test
			 tree out. Use it when the core test tree does not compile (for example while a change
			 to it is in flight). Activate with -Drevetsec.fuzz.mainSourcesOnly. -->
		<profile>
			<id>main-sources-only</id>
			<activation>
				<property>
					<name>revetsec.fuzz.mainSourcesOnly</name>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>build-helper-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>add-core-test-sources</id>
								<phase>none</phase>
							</execution>
							<execution>
								<id>add-core-test-resources</id>
								<phase>none</phase>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
