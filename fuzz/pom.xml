<!--
	Revetsec fuzz tooling. This pom is NOT built by the root pom and is never published:
	install and deploy are skipped below. It compiles Revetsec's main sources directly
	(../src/main/java), plus the core test tree (../src/test/java, ../src/test/resources) so that
	fuzz targets can reuse test helpers and fixtures. The core test tree is filtered: Failsafe ITs
	(**/*IT.java), the Testcontainers-backed scripted-IdP classes (com/revetsec/saml/ScriptedIdp*)
	and the Netty-backed HTTP/2 harness and its tests
	are excluded, so nothing here needs Docker or Testcontainers.

	Replay every seed, the module's own and the corpora mapped in below (Jazzer regression mode):
	  mvn -B -ntp -f fuzz/pom.xml clean verify

	Fuzz one @FuzzTest method (see README.md for the options that keep generated files out of the tree):
	  JAZZER_FUZZ=1 mvn -B -ntp -f fuzz/pom.xml test -Dtest='<Class>#<method>' -Djazzer.max_duration=5m

	Compile against the core main sources only, without the core test tree:
	  mvn -B -ntp -f fuzz/pom.xml -Drevetsec.fuzz.mainSourcesOnly verify
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.revetsec</groupId>
	<artifactId>revetsec-fuzz</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>Revetsec Fuzz Tests</name>
	<description>Jazzer fuzz targets for Revetsec. Test tooling only; never published.</description>
	<url>https://www.revetsec.com</url>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<project.build.outputTimestamp>2026-09-01T00:00:00Z</project.build.outputTimestamp>
		<maven.compiler.release>17</maven.compiler.release>
		<!-- Same Jazzer line as Soklet's fuzz/ (0.30.0 is the latest on Central as of 2026-09-23). -->
		<jazzer.version>0.30.0</jazzer.version>
		<!-- Jazzer supports JUnit 5.9.0 and newer. The JUnit BOM aligns Jazzer's transitive JUnit
			 modules (jupiter-params, platform-commons, platform-launcher) with the explicit
			 API/engine/launcher dependencies below. Without it, old Platform classes stay on the
			 test classpath and the run can fail before any corpus input executes. -->
		<junit.version>6.1.3</junit.version>
		<!-- The Revetsec core checkout whose sources this module compiles. The core test tree is
			 compiled in by default; the "main-sources-only" profile unbinds the add-core-test-*
			 executions. -->
		<revetsec.core.basedir>${project.basedir}/..</revetsec.core.basedir>
		<!-- Empty by default. The "jdk23-plus-unsafe-memory-access" profile sets this to the JDK 23+
			 "sun.misc.Unsafe memory-access" allow flag (JEP 471), which the JVM only recognizes on
			 JDK 23 and newer. Passing it on JDK 17 through 22 crashes the forked test VM with an
			 "Unrecognized option" error. -->
		<surefire.unsafeMemoryAccessArg></surefire.unsafeMemoryAccessArg>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Compile-time-only annotations used by Revetsec's main sources (same as core). -->
		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
			<version>1.0.1</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.google.code.findbugs</groupId>
			<artifactId>jsr305</artifactId>
			<version>3.0.2</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.google.errorprone</groupId>
			<artifactId>error_prone_annotations</artifactId>
			<version>2.50.0</version>
			<scope>provided</scope>
		</dependency>

		<!-- Test scope only. -->
		<dependency>
			<groupId>com.code-intelligence</groupId>
			<artifactId>jazzer-junit</artifactId>
			<version>${jazzer.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<!-- Seed corpora. The module's own curated seeds are in src/test/resources/<package>/<Class>Inputs/<method>/.
			 The larger corpora stay where the core build keeps (and SHA-256-checks) them, and are mapped here into
			 each target's Jazzer inputs directory through targetPath, so they are never duplicated in the tree:
			 - the core JSON corpus (corpus/parse and corpus/round-trip, the .bin files included) and every
			   JSONTestSuite test_parsing file, for each JSON target that reads JSON text and for the two JOSE targets
			   that do (the JOSE header and the JWK Set document);
			 - the Entra key-set captures (com/revetsec/jose/entra/<date>/*-keys.json), for the JWK Set target;
			 - the TEST ONLY PEM fixtures (fixtures/pem and fixtures/keys), for the PEM text target.
			 Mapped seeds exist only under target/test-classes, which is where .clusterfuzzlite/build.sh zips every
			 target's seeds from. Jazzer reads an inputs directory recursively, so the subdirectories are kept. -->
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
			<testResource>
				<directory>${revetsec.core.basedir}/src/test/resources/com/revetsec/internal/json/corpus</directory>
				<targetPath>com/revetsec/internal/json/JsonCodecFuzzTestsInputs/parseRejectsOnlyWithJsonParseExceptionAndAcceptsOnlyValuesInsideTheProfile</targetPath>
				<includes>
					<include>parse/**</include>
					<include>round-trip/**</include>
				</includes>
			</testResource>
			<testResource>
				<directory>${revetsec.core.basedir}/src/test/resources/vectors/jsontestsuite/test_parsing</directory>
				<targetPath>com/revetsec/internal/json/JsonCodecFuzzTestsInputs/parseRejectsOnlyWithJsonParseExceptionAndAcceptsOnlyValuesInsideTheProfile/jsontestsuite</targetPath>
				<includes>
					<include>*.json</include>
				</includes>
			</testResource>
			<testResource>
				<directory>${revetsec.core.basedir}/src/test/resources/com/revetsec/internal/json/corpus</directory>
				<targetPath>com/revetsec/internal/json/JsonCodecFuzzTestsInputs/acceptedValuesRoundTripUnderTheMaximumCapProfile</targetPath>
				<includes>
					<include>parse/**</include>
					<include>round-trip/**</include>
				</includes>
			</testResource>
			<testResource>
				<directory>${revetsec.core.basedir}/src/test/resources/vectors/jsontestsuite/test_parsing</directory>
				<targetPath>com/revetsec/internal/json/JsonCodecFuzzTestsInputs/acceptedValuesRoundTripUnderTheMaximumCapProfile/jsontestsuite</targetPath>
				<includes>
