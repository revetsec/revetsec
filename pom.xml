<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.revetsec</groupId>
	<artifactId>revetsec</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>RevetSec</name>
	<description>Zero-dependency Java library for OAuth 2.0 clients and resource servers, OpenID Connect relying parties, JOSE, SAML 2.0 service providers and SCIM 2.0 servers.</description>
	<url>https://www.revetsec.com</url>

	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Mark Allen</name>
			<email>mark@revetware.com</email>
			<organization>Revetware LLC</organization>
			<organizationUrl>https://www.revetware.com</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git@github.com:revetsec/revetsec.git</connection>
		<developerConnection>scm:git:git@github.com:revetsec/revetsec.git</developerConnection>
		<url>https://github.com/revetsec/revetsec</url>
	</scm>

	<!-- Sibling precedent. SNAPSHOTs are not published unless the owner authorizes it (D48). -->
	<distributionManagement>
		<repository>
			<name>Central Portal Snapshots</name>
			<id>central-portal-snapshots</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<project.build.outputTimestamp>2026-09-01T00:00:00Z</project.build.outputTimestamp>

		<!-- Build plugins -->
		<maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
		<maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
		<maven.surefire.plugin.version>3.6.0</maven.surefire.plugin.version>
		<maven.failsafe.plugin.version>3.6.0</maven.failsafe.plugin.version>
		<maven.source.plugin.version>3.4.0</maven.source.plugin.version>
		<maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
		<maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
		<maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
		<central.publishing.plugin.version>0.11.0</central.publishing.plugin.version>

		<!-- Analysis and quality profiles -->
		<error.prone.version>2.50.0</error.prone.version>
		<nullaway.version>0.14.1</nullaway.version>
		<spotbugs.maven.plugin.version>4.10.4.1</spotbugs.maven.plugin.version>
		<findsecbugs.version>1.14.0</findsecbugs.version>
		<jacoco.maven.plugin.version>0.8.15</jacoco.maven.plugin.version>
		<pitest.maven.version>1.30.0</pitest.maven.version>
		<pitest.junit5.plugin.version>1.2.3</pitest.junit5.plugin.version>
		<japicmp.maven.plugin.version>0.26.2</japicmp.maven.plugin.version>

		<!-- Provided-scope annotations (never compile or runtime scope) -->
		<jspecify.version>1.0.1</jspecify.version>
		<jsr305.version>3.0.2</jsr305.version>
		<error.prone.annotations.version>2.50.0</error.prone.annotations.version>

		<!-- Test scope -->
		<junit.jupiter.version>6.1.3</junit.jupiter.version>
		<testcontainers.version>2.0.5</testcontainers.version>

		<!-- The javadoc JAR is built by a separately pinned JDK (REVETSEC_JAVADOC_HOME), as in Soklet.
		     Every CI job passes -Dmaven.javadoc.skip=true until M1, when the first public type exists. -->
		<revetsec.javadoc.executable>${env.REVETSEC_JAVADOC_HOME}/bin/javadoc</revetsec.javadoc.executable>
		<revetsec.spotbugs.excludeFilterFile>${project.basedir}/config/spotbugs-exclude.xml</revetsec.spotbugs.excludeFilterFile>

		<!-- Coverage floors (coverage profile). Proposed values, above Pyranid's 0.74/0.63; revisit at M1
		     once real code exists. The per-package floors apply to internal.jose, internal.xml, oidc and saml. -->
		<revetsec.coverage.bundle.instruction>0.80</revetsec.coverage.bundle.instruction>
		<revetsec.coverage.bundle.branch>0.70</revetsec.coverage.bundle.branch>
		<revetsec.coverage.critical.instruction>0.90</revetsec.coverage.critical.instruction>
		<revetsec.coverage.critical.branch>0.85</revetsec.coverage.critical.branch>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven.enforcer.plugin.version}</version>
				<executions>
					<execution>
						<id>enforce-build-contract</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
								<requireJavaVersion>
									<version>[17,)</version>
								</requireJavaVersion>
								<dependencyConvergence/>
								<bannedDependencies>
									<searchTransitive>true</searchTransitive>
									<excludes>
										<exclude>*:*:*:*:compile</exclude>
										<exclude>*:*:*:*:runtime</exclude>
										<exclude>*:*:*:*:system</exclude>
									</excludes>
									<message>RevetSec core must not declare compile, runtime or system dependencies; use provided or test scope instead.</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven.compiler.plugin.version}</version>
				<configuration>
					<release>17</release>
					<compilerArgs>
						<arg>-parameters</arg>
						<arg>-Xlint:all</arg>
					</compilerArgs>
					<!-- No annotation processing in the default build. The static-analysis profile enables it
					     only for Error Prone and NullAway. -->
					<proc>none</proc>
					<showDeprecation>true</showDeprecation>
					<showWarnings>true</showWarnings>
					<!-- Testcontainers is declared only in the integration profile (test scope), so the classes
					     that need it are compiled only there. The fuzz module excludes the same files. -->
					<testExcludes>
						<testExclude>**/*IT.java</testExclude>
						<testExclude>com/revetsec/saml/ScriptedIdp*.java</testExclude>
					</testExcludes>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven.surefire.plugin.version}</version>
				<!-- Only junit-jupiter-api is declared. Surefire detects it and provisions the matching
				     JUnit 6 engine and platform launcher itself (Soklet and Pyranid precedent). -->
				<configuration>
					<includes>
						<include>**/*Tests.java</include>
					</includes>
					<failIfNoTests>true</failIfNoTests>
					<trimStackTrace>false</trimStackTrace>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>${maven.source.plugin.version}</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>${maven.jar.plugin.version}</version>
				<configuration>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<manifestEntries>
							<Automatic-Module-Name>com.revetsec</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>${maven.javadoc.plugin.version}</version>
				<configuration>
					<!-- Documentation uses a separately pinned JDK; compilation still targets 17. Required from M1;
					     until then every build passes -Dmaven.javadoc.skip=true (there is no public type yet). -->
					<javadocExecutable>${revetsec.javadoc.executable}</javadocExecutable>
					<detectJavaApiLink>false</detectJavaApiLink>
					<detectOfflineLinks>false</detectOfflineLinks>
					<offlineLinks>
						<offlineLink>
							<url>https://docs.oracle.com/en/java/javase/26/docs/api/</url>
							<location>${project.basedir}/src/main/javadoc/links/java-26</location>
						</offlineLink>
						<offlineLink>
							<url>https://javadoc.io/static/com.google.code.findbugs/jsr305/3.0.2/</url>
							<location>${project.basedir}/src/main/javadoc/links/jsr305-3.0.2</location>
						</offlineLink>
						<offlineLink>
							<url>https://javadoc.io/static/org.jspecify/jspecify/1.0.1/</url>
							<location>${project.basedir}/src/main/javadoc/links/jspecify-1.0.1</location>
						</offlineLink>
					</offlineLinks>
					<quiet>true</quiet>
					<notimestamp>true</notimestamp>
					<encoding>UTF-8</encoding>
					<docencoding>UTF-8</docencoding>
					<charset>UTF-8</charset>
					<!-- com.revetsec.internal.* is public by necessity but is not API: never documented. Public
					     sources are documented explicitly and internal symbols resolve from the just-built
					     artifact (Soklet precedent). -->
					<sourceFileExcludes>
						<sourceFileExclude>**/internal/**/*.java</sourceFileExclude>
					</sourceFileExcludes>
					<disableSourcepathUsage>true</disableSourcepathUsage>
					<legacyMode>true</legacyMode>
					<additionalDependencies>
						<additionalDependency>
							<groupId>${project.groupId}</groupId>
							<artifactId>${project.artifactId}</artifactId>
							<version>${project.version}</version>
						</additionalDependency>
					</additionalDependencies>
					<additionalOptions>
						<additionalOption>-XDignore.symbol.file</additionalOption>
						<additionalOption>-Xdoclint:-html</additionalOption>
					</additionalOptions>
					<linksource>true</linksource>
					<show>public</show>
					<bottom><![CDATA[Copyright 2026 <a href="https://www.revetware.com" target="_blank">Revetware LLC</a>.]]></bottom>
					<source>17</source>
					<failOnError>true</failOnError>
					<overview>${project.basedir}/src/main/javadoc/overview.html</overview>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- Compile-time-only annotations. Nothing is ever compile or runtime scope (enforced above). -->
		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
			<version>${jspecify.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.google.code.findbugs</groupId>
			<artifactId>jsr305</artifactId>
			<version>${jsr305.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.google.errorprone</groupId>
			<artifactId>error_prone_annotations</artifactId>
			<version>${error.prone.annotations.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Testing-only dependencies -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<!--
			Publishing (plan 10.5). Nothing is published without the owner's explicit authorization, and
			`mvn deploy` is never run from a developer machine. The Central Portal deployment is left for a
			manual publish in the Portal UI.
		-->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>${maven.gpg.plugin.version}</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>${central.publishing.plugin.version}</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central-portal</publishingServerId>
							<autoPublish>false</autoPublish>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			Static-analysis gate. Run on JDK 21 (Error Prone requires JDK 21+ to run and lags the newest JDKs).
			The release-17 target is unchanged.

			  JAVA_HOME=<jdk21> mvn -B -ntp -Pstatic-analysis -Dmaven.javadoc.skip=true verify

			NullAway runs at ERROR from day one (plan R2) with com.revetsec as the annotated package. It applies
			to test code in com.revetsec too. The promoted Error Prone checks follow Soklet's list.
		-->
		<profile>
			<id>static-analysis</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<fork>true</fork>
							<proc>full</proc>
							<annotationProcessorPaths>
								<path>
									<groupId>com.google.errorprone</groupId>
									<artifactId>error_prone_core</artifactId>
									<version>${error.prone.version}</version>
								</path>
								<path>
									<groupId>com.uber.nullaway</groupId>
									<artifactId>nullaway</artifactId>
									<version>${nullaway.version}</version>
								</path>
							</annotationProcessorPaths>
							<compilerArgs combine.children="append">
								<arg>-Xmaxwarns</arg>
								<arg>100000</arg>
								<arg>-Xmaxerrs</arg>
								<arg>100000</arg>
								<arg>-XDcompilePolicy=simple</arg>
								<arg>--should-stop=ifError=FLOW</arg>
								<arg>-XDaddTypeAnnotationsToSymbol=true</arg>
								<arg>-Xplugin:ErrorProne -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=com.revetsec -Xep:DefaultCharset:ERROR -Xep:StringSplitter:ERROR -Xep:StringCaseLocaleUsage:ERROR -Xep:ReferenceEquality:ERROR -Xep:EmptyCatch:ERROR -Xep:NullableVoid:ERROR -Xep:AnnotateFormatMethod:ERROR -Xep:UnusedMethod:ERROR -Xep:UnusedVariable:ERROR -Xep:Finally:ERROR -Xep:NarrowingCompoundAssignment:ERROR -Xep:MissingSummary:OFF</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
								<arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
								<arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
							</compilerArgs>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			SpotBugs + FindSecBugs gate, JDK 21. Every entry in the exclude filter needs a written reason.

			  JAVA_HOME=<jdk21> mvn -B -ntp -Pspotbugs -Dmaven.javadoc.skip=true verify
		-->
		<profile>
			<id>spotbugs</id>
			<build>
				<plugins>
					<plugin>
						<groupId>com.github.spotbugs</groupId>
						<artifactId>spotbugs-maven-plugin</artifactId>
						<version>${spotbugs.maven.plugin.version}</version>
						<configuration>
							<effort>Max</effort>
							<threshold>Medium</threshold>
							<failOnError>true</failOnError>
							<xmlOutput>true</xmlOutput>
							<excludeFilterFile>${revetsec.spotbugs.excludeFilterFile}</excludeFilterFile>
							<plugins>
								<plugin>
									<groupId>com.h3xstream.findsecbugs</groupId>
									<artifactId>findsecbugs-plugin</artifactId>
									<version>${findsecbugs.version}</version>
								</plugin>
							</plugins>
						</configuration>
						<executions>
							<execution>
								<id>spotbugs-check</id>
								<phase>verify</phase>
								<goals>
									<goal>check</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			JaCoCo coverage floors: a bundle floor above Pyranid's 0.74/0.63, plus stricter per-package floors
			for internal.jose, internal.xml, oidc and saml. Package names use '?' so the rule matches whether
			JaCoCo reports them with dots or slashes.

			  mvn -B -ntp -Pcoverage -Dmaven.javadoc.skip=true verify
		-->
		<profile>
			<id>coverage</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<version>${jacoco.maven.plugin.version}</version>
						<configuration>
							<includes>
								<include>com/revetsec/**</include>
							</includes>
						</configuration>
						<executions>
							<execution>
								<id>prepare-agent</id>
								<goals>
									<goal>prepare-agent</goal>
								</goals>
							</execution>
							<execution>
								<id>report</id>
								<phase>test</phase>
								<goals>
									<goal>report</goal>
								</goals>
							</execution>
							<execution>
								<id>check</id>
								<phase>verify</phase>
								<goals>
									<goal>check</goal>
								</goals>
								<configuration>
									<rules>
										<rule>
											<element>BUNDLE</element>
											<limits>
												<limit>
													<counter>INSTRUCTION</counter>
													<value>COVEREDRATIO</value>
													<minimum>${revetsec.coverage.bundle.instruction}</minimum>
												</limit>
												<limit>
													<counter>BRANCH</counter>
													<value>COVEREDRATIO</value>
													<minimum>${revetsec.coverage.bundle.branch}</minimum>
												</limit>
											</limits>
										</rule>
										<rule>
											<element>PACKAGE</element>
											<includes>
												<include>com?revetsec?internal?jose</include>
												<include>com?revetsec?internal?xml</include>
												<include>com?revetsec?oidc</include>
												<include>com?revetsec?saml</include>
											</includes>
											<limits>
												<limit>
													<counter>INSTRUCTION</counter>
													<value>COVEREDRATIO</value>
													<minimum>${revetsec.coverage.critical.instruction}</minimum>
												</limit>
												<limit>
													<counter>BRANCH</counter>
													<value>COVEREDRATIO</value>
													<minimum>${revetsec.coverage.critical.branch}</minimum>
												</limit>
											</limits>
										</rule>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			PIT mutation testing (plan 14.5) on internal.jose, internal.xml, the OAuth pipeline (internal.oauth) and
			the oidc, saml and scim validators. At M0 there is nothing to mutate, so an empty run passes; from M1 on,
			every surviving mutant is killed or justified in writing at each RC.

			  mvn -B -ntp -Pmutation -Dmaven.javadoc.skip=true verify
		-->
		<profile>
			<id>mutation</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<version>${pitest.maven.version}</version>
						<dependencies>
							<dependency>
								<groupId>org.pitest</groupId>
								<artifactId>pitest-junit5-plugin</artifactId>
								<version>${pitest.junit5.plugin.version}</version>
							</dependency>
						</dependencies>
						<configuration>
							<targetClasses>
								<param>com.revetsec.internal.jose.*</param>
								<param>com.revetsec.internal.xml.*</param>
								<param>com.revetsec.internal.oauth.*</param>
								<param>com.revetsec.oidc.*</param>
								<param>com.revetsec.saml.*</param>
								<param>com.revetsec.scim.*</param>
							</targetClasses>
							<targetTests>
								<param>com.revetsec.*</param>
							</targetTests>
							<!-- Source-inventory contract tests never exercise production code paths. -->
							<excludedTestClasses>
								<param>com.revetsec.PublicApiContractTests</param>
								<param>com.revetsec.PackageDependencyTests</param>
								<param>com.revetsec.SourcePolicyTests</param>
								<param>com.revetsec.ClaimsLintTests</param>
								<param>com.revetsec.ContractMetaTests</param>
								<param>com.revetsec.LocaleCanaryTests</param>
							</excludedTestClasses>
							<failWhenNoMutations>false</failWhenNoMutations>
							<timestampedReports>false</timestampedReports>
							<outputFormats>
								<param>HTML</param>
								<param>XML</param>
							</outputFormats>
						</configuration>
						<executions>
							<execution>
								<id>mutation-coverage</id>
								<phase>verify</phase>
								<goals>
									<goal>mutationCoverage</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			Container-backed integration tests (*IT.java under src/test/java), run by Failsafe. Testcontainers is
			declared here only, at test scope. There are no ITs at M0.

			  mvn -B -ntp -Pintegration -Dmaven.javadoc.skip=true verify
		-->
		<profile>
			<id>integration</id>
			<dependencies>
				<dependency>
					<groupId>org.testcontainers</groupId>
					<artifactId>testcontainers</artifactId>
					<version>${testcontainers.version}</version>
					<scope>test</scope>
				</dependency>
				<dependency>
					<groupId>org.testcontainers</groupId>
					<artifactId>testcontainers-junit-jupiter</artifactId>
					<version>${testcontainers.version}</version>
					<scope>test</scope>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<testExcludes combine.self="override"/>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>${maven.failsafe.plugin.version}</version>
						<configuration>
							<includes>
								<include>**/*IT.java</include>
							</includes>
							<trimStackTrace>false</trimStackTrace>
						</configuration>
						<executions>
							<execution>
								<id>integration-tests</id>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			API compatibility gate. STUB until 1.0.0: there is no released baseline to compare against, so the
			plugin is declared but skipped. At 1.0.0, set revetsec.api.baseline.version to the released version,
			remove <skip>, and break the build on binary- and source-incompatible changes and on semantic-version
			violations (Pyranid precedent; plan 10.2).
		-->
		<profile>
			<id>api-diff</id>
			<properties>
				<revetsec.api.baseline.version>1.0.0</revetsec.api.baseline.version>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>com.github.siom79.japicmp</groupId>
						<artifactId>japicmp-maven-plugin</artifactId>
						<version>${japicmp.maven.plugin.version}</version>
						<configuration>
							<skip>true</skip>
							<oldVersion>
								<dependency>
									<groupId>${project.groupId}</groupId>
									<artifactId>${project.artifactId}</artifactId>
									<version>${revetsec.api.baseline.version}</version>
									<type>jar</type>
								</dependency>
							</oldVersion>
							<newVersion>
								<file>
									<path>${project.build.directory}/${project.build.finalName}.jar</path>
								</file>
							</newVersion>
							<parameter>
								<accessModifier>protected</accessModifier>
								<onlyModified>true</onlyModified>
								<excludes>
									<exclude>com.revetsec.internal</exclude>
									<exclude>com.revetsec.internal.*</exclude>
								</excludes>
								<breakBuildBasedOnSemanticVersioning>true</breakBuildBasedOnSemanticVersioning>
								<breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
								<breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
							</parameter>
						</configuration>
						<executions>
							<execution>
								<id>check-api-compatibility</id>
								<phase>verify</phase>
								<goals>
									<goal>cmp</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
