{
	admin off
	auto_https off
	servers {
		protocols h1 h2
	}
}

https://localhost:8443 {
	bind 127.0.0.1
	tls {$REVETSEC_TLS_CERT} {$REVETSEC_TLS_KEY}
	route {
		@ambiguous expression `{http.request.header.Authorization}.contains(",") || {http.request.header.Origin}.contains(",") || {http.request.header.Content-Type}.contains(",") || {http.request.header.Cookie}.contains(",")`
		respond @ambiguous "" 400
		@Mcp path /mcp /mcp/*
		handle @Mcp {
			reverse_proxy 127.0.0.1:8081 {
				header_up Host 127.0.0.1:8081
			}
		}
		handle {
			reverse_proxy 127.0.0.1:8080
		}
	}
}

https://localhost:8445 {
	bind 127.0.0.1
	tls {$REVETSEC_TLS_CERT} {$REVETSEC_TLS_KEY}
	route {
		@ambiguous expression `{http.request.header.Authorization}.contains(",") || {http.request.header.Origin}.contains(",") || {http.request.header.Content-Type}.contains(",") || {http.request.header.Cookie}.contains(",")`
		respond @ambiguous "" 400
		reverse_proxy 127.0.0.1:8082
	}
}
