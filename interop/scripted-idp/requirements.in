# Direct dependencies of the scripted IdP. requirements.txt
# is the hash-locked closure of this file for cp313 musllinux_1_2 wheels.
#
# lxml and xmlsec move only together: the xmlsec 1.3.17 wheels statically link
# libxml2 2.14.6 and are built to match lxml 6.0.2. The selftest fails the
# image build if the two libxml2 copies differ, down to the patch level.
xmlsec==1.3.17
lxml==6.0.2
signxml==5.1.0
cryptography==50.0.2
