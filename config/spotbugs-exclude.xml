<?xml version="1.0" encoding="UTF-8"?>
<!--
	SpotBugs + FindSecBugs exclusions for the spotbugs profile.

	Every exclusion must be as narrow as possible (a pattern plus a class and
	method, not a whole category) and carry a comment saying why the finding is a false positive or an
	accepted risk.
-->
<FindBugsFilter>
	<!-- RFC 7517 section 4.8 defines x5t specifically as a SHA-1 certificate identifier. This publisher
	     emits it for compatibility alongside the SHA-256 x5t#S256 identifier. It never uses SHA-1 for
	     signing, certificate trust or signature verification; publication tests check both exact digests.
	     Keep the exception limited to certificate metadata serialization in this one method. -->
	<Match>
		<Bug pattern="WEAK_MESSAGE_DIGEST_SHA1"/>
		<Class name="com.revetsec.jose.PublishedJwk"/>
		<Method name="snapshotCertificates" signature="(Lcom/revetsec/json/JsonObject;Ljava/util/List;)Lcom/revetsec/json/JsonObject;"/>
	</Match>
	<!-- Cleanup deliberately preserves the checked operation failure and fixed diagnostics.
	     The socket/selector closure is always attempted; a late IOException cannot expose remote text
	     or turn cleanup into a new operation outcome. Local closure tests check resource release. -->
	<Match>
		<Bug pattern="DE_MIGHT_IGNORE"/>
		<Class name="com.revetsec.internal.http.PinnedTlsChannel"/>
		<Method name="close" signature="()V"/>
	</Match>
	<!-- The copied Soklet map retains its upstream non-final class/throwing capacity constructors.
	     The Revetsec default constructs the concrete map only after validating capacity, passes no
	     listener and keeps it private; constructor state contains no entries, credentials or core
	     references. A failed external subclass construction cannot recover a Revetsec-owned cache.
	     Keep this exclusion on these two constructors only; provenance pins the unchanged bodies. -->
	<Match>
		<Bug pattern="CT_CONSTRUCTOR_THROW"/>
		<Class name="com.revetsec.internal.ConcurrentLruMap"/>
		<Method name="&lt;init&gt;" signature="(I)V"/>
	</Match>
	<Match>
		<Bug pattern="CT_CONSTRUCTOR_THROW"/>
		<Class name="com.revetsec.internal.ConcurrentLruMap"/>
		<Method name="&lt;init&gt;" signature="(ILjava/util/function/BiConsumer;)V"/>
	</Match>
	<!-- SAML verification must dereference the very same DOM nodes that were parsed and structurally checked.
	     Cloning these internal-only nodes to appease EI_EXPOSE_REP would break identity-bound XML Signature checks.
	     The SP package alone consumes these references; no checked identity is released from them. -->
	<Match>
		<Bug pattern="EI_EXPOSE_REP"/>
		<Class name="com.revetsec.internal.xml.SecureXmlParser$Result$Accepted"/>
		<Method name="getDocument" signature="()Lorg/w3c/dom/Document;"/>
	</Match>
	<Match>
		<Bug pattern="EI_EXPOSE_REP"/>
		<Class name="com.revetsec.internal.xml.SamlResponseStructure$Shape"/>
		<Method name="~get(Response|Issuer|ResponseSignature|Status|Assertion|EncryptedAssertion)"/>
	</Match>
	<!-- The digest comparisons select fixed public XMLDSig algorithm URIs before verification;
	     they never compare a secret digest value. The remaining signature proof is done by JDK XMLDSig. -->
	<Match>
		<Bug pattern="UNSAFE_HASH_EQUALS"/>
		<Class name="com.revetsec.internal.xml.EnvelopedSignatureVerifier"/>
		<Method name="inspectSignature"/>
	</Match>
	<!-- The exact verified DOM element must remain identical to the node later used for SAML semantics.
	     Cloning it would discard that signed-node binding; this is an internal-only result. -->
	<Match>
		<Bug pattern="EI_EXPOSE_REP"/>
		<Class name="com.revetsec.internal.xml.EnvelopedSignatureVerifier$Verified"/>
		<Method name="getElement" signature="()Lorg/w3c/dom/Element;"/>
	</Match>
	<!-- The form action and fields originate from Revetsec's bounded request builder. The renderer
	     escapes every attribute string before concatenation; the optional script nonce is validated
	     against a strict ASCII allowlist. SpotBugs cannot follow those local validation methods. -->
	<Match>
		<Bug pattern="POTENTIAL_XML_INJECTION"/>
		<Class name="com.revetsec.saml.SamlPostForm"/>
		<Method name="toHtml"/>
	</Match>
	<!-- This exact OR intentionally computes the historical bcrypt sign-extended word alongside
	     words[0]'s corrected word. Spring uses their difference for accepted $2a$ collision-safety
	     logic; Revetsec rejects $2x$ hashes. Changing words[1] would alter verification behavior.
	     BCrypt.java is pinned to Spring Security 6.5.11 by BcryptVendoredSourceTests. -->
	<Match>
		<Bug pattern="BIT_IOR_OF_SIGNED_BYTE"/>
		<Class name="com.revetsec.internal.password.vendor.spring.BCrypt"/>
		<Method name="streamtowords" signature="([B[I[I)[I"/>
	</Match>
	<!-- A Java char is unsigned, so the x < 0 half of this upstream bounds check is unreachable.
	     The x >= index_64.length half remains effective; retain the pinned source unchanged. -->
	<Match>
		<Bug pattern="INT_BAD_COMPARISON_WITH_NONNEGATIVE_VALUE"/>
		<Class name="com.revetsec.internal.password.vendor.spring.BCrypt"/>
		<Method name="char64" signature="(C)B"/>
	</Match>
	<!-- SpotBugs describes one-shot java.util.Random as yielding mediocre numbers. This site uses
	     a fresh platform SecureRandom for each 16-byte Argon2id salt, after work admission, so the
	     algorithm is cryptographic and no SecureRandom instance is shared among calls. Reusing
	     a provider instance here would introduce shared state solely for this generic diagnostic. -->
	<Match>
		<Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
		<Class name="com.revetsec.password.PasswordHasher"/>
		<Method name="hashResult" signature="([C)Lcom/revetsec/password/PasswordHashResult;"/>
	</Match>
</FindBugsFilter>
